
"""
PREM SWARM AI — Phase 2 V2 Integration Adapter

SAFE MODE:
- Does not generate/write project code.
- Does not call an external LLM.
- Does not execute arbitrary generated code.
- Only coordinates existing component interfaces.
"""

from dataclasses import dataclass, field
from typing import Any, Dict, List, Optional


@dataclass
class AdapterResult:
    status: str
    stage: str
    message: str
    details: Dict[str, Any] = field(default_factory=dict)


class Phase2IntegrationAdapter:
    """
    Safe boundary between the new Phase-2 autonomy engine
    and the existing PREM Swarm agents.

    This version intentionally operates in dry-run mode.
    """

    def __init__(self, root=None, dry_run=True):
        from pathlib import Path

        self.root = Path(root or ".").resolve()
        self.dry_run_mode = dry_run

        self.model = None
        self.intelligence = None
        self.architect = None
        self.verifier = None
        self.repair = None
        self.gate = None

        self.coder = None
        self.executor = None
        self.healer = None
        self.reviewer = None
        self.failure_analyzer = None
        self.sandbox = None
        self.memory = None

        # Load dependencies during adapter initialization.
        # This keeps status() truthful and makes the adapter
        # immediately ready for controlled integration tests.
        self.load_phase2()
        self.load_existing_agents()

    def load_phase2(self):
        from .model_adapter import ModelAdapter
        from .codebase_intelligence import CodebaseIntelligence
        from .architect import AutonomousArchitect
        from .verification import VerificationEngine
        from .repair_engine import RepairEngine
        from .integration_gate import IntegrationGate

        self.model = ModelAdapter()
        self.intelligence = CodebaseIntelligence(self.root)
        self.architect = AutonomousArchitect(self.model)
        self.verifier = VerificationEngine(self.root)
        self.repair = RepairEngine(self.model)
        self.gate = IntegrationGate(
            self.root,
            self.root / ".swarm_builder" / "backups"
        )

        return True

    def load_existing_agents(self):
        """
        Import and instantiate existing agents using their
        discovered constructor signatures.

        No generation or execution is performed here.
        """

        from agent_coder import CoderAgent
        from agent_executor import CodeExecutorAgent
        from agent_healer import AutoHealerAgent
        from agent_reviewer import ReviewerAgent
        from brain.failure_analyzer import FailureAnalyzer
        from safety.sandbox import ExecutionSandbox
        from memory.memory_core import MemoryCore

        self.coder = CoderAgent()
        self.executor = CodeExecutorAgent("phase2-v2")
        self.healer = AutoHealerAgent()
        self.reviewer = ReviewerAgent()
        self.failure_analyzer = FailureAnalyzer()
        self.sandbox = ExecutionSandbox()

        memory_path = self.root / "swarm_memory.db"
        self.memory = MemoryCore(str(memory_path))

        return True

    def audit_components(self):
        components = {
            "phase2.model": self.model,
            "phase2.intelligence": self.intelligence,
            "phase2.architect": self.architect,
            "phase2.verifier": self.verifier,
            "phase2.repair": self.repair,
            "phase2.gate": self.gate,
            "existing.coder": self.coder,
            "existing.executor": self.executor,
            "existing.healer": self.healer,
            "existing.reviewer": self.reviewer,
            "existing.failure_analyzer": self.failure_analyzer,
            "existing.sandbox": self.sandbox,
            "existing.memory": self.memory,
        }

        result = {}

        for name, obj in components.items():
            result[name] = {
                "loaded": obj is not None,
                "type": type(obj).__name__ if obj else None,
            }

        return result

    def dry_run(self, pillar_name="V2_INTEGRATION_TEST"):
        """
        Validate the complete intended control flow without
        modifying files or generating code.
        """

        stages = [
            "pillar_received",
            "codebase_intelligence",
            "architect",
            "coder_boundary",
            "integration_gate",
            "executor_boundary",
            "reviewer_boundary",
            "verification",
            "failure_analyzer_boundary",
            "healer_boundary",
            "memory_boundary",
            "next_pillar",
        ]

        return AdapterResult(
            status="PASS",
            stage="dry_run",
            message="Phase 2 V2 integration boundaries are ready.",
            details={
                "pillar": pillar_name,
                "dry_run": self.dry_run,
                "stages": stages,
                "components": self.audit_components(),
                "real_code_generation": False,
                "real_execution": False,
                "filesystem_mutation": False,
                "external_llm_call": False,
            },
        )

    def status(self):
        return {
            "adapter": "Phase2IntegrationAdapter",
            "mode": "DRY_RUN" if self.dry_run else "LIVE",
            "phase2_loaded": self.architect is not None,
            "existing_agents_loaded": self.coder is not None,
            "root": str(self.root),
        }
